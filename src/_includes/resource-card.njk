<article class="resource-card">
  <div class="resource-card-meta">
    <p class="resource-category">{{ resourceCategories[resource.data.category] }}</p>
    <time datetime="{{ resource.date | isoDate }}">{{ resource.date | resourceDate }}</time>
  </div>
  <div class="resource-card-body">
    <h3><a href="{{ resource.url }}">{{ resource.data.title | escape }}</a></h3>
    <p>{{ resource.data.summary | escape }}</p>
  </div>
</article>
